# ---- LLM API Key (Fill ONE - Groq is free: https://console.groq.com/keys) ----
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# ---- App Settings ----
APP_TIMEZONE=Asia/Kolkata
DB_PATH=medicine_reminder.db

# ---- Email Notifications (Optional Backup) ----
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
